{
  "_comment": "Copy the customModels you want into ~/.factory/settings.json (merge with existing keys). API keys stay on your machine and are never uploaded. apiKey supports ${ENV_VAR} expansion. Full field reference: https://docs.factory.com/model-independence/byok",
  "customModels": [
    {
      "model": "gpt-5.3-codex",
      "displayName": "OpenAI (my key)",
